{
  // Code that runs in Node: Electron main + preload, pure core logic, configs and tests.
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "electron.vite.config.mts",
    "vitest.config.mts",
    "playwright.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/core/**/*",
    "tests/**/*",
    "scripts/**/*"
  ]
}
