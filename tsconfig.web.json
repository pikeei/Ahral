{
  // Code that runs in the browser window. Deliberately has no Node types,
  // so accidentally importing 'fs' or 'path' in the UI is a type error.
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/core/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
