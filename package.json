{
  "name": "ahral",
  "productName": "Ahral",
  "version": "0.1.0",
  "description": "Offline PDF-to-exam generator using rule-based NLP (no generative AI).",
  "private": true,
  "author": "Paul Kenneth Ilan",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "package": "electron-vite build && electron-builder --win --dir --publish never",
    "test:packaged": "npm run package && playwright test -c playwright.packaged.config.ts",
    "installer": "electron-builder --win --prepackaged dist/win-unpacked --publish never",
    "extract": "tsx scripts/extract.mts",
    "sample-pdf": "tsx scripts/make-sample-pdf.mts",
    "icon": "tsx scripts/make-icon.mts",
    "analyze": "tsx scripts/analyze.mts",
    "generate": "tsx scripts/generate.mts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:coverage": "vitest run --coverage",
    "exam": "tsx scripts/exam.mts",
    "web:dev": "vite --config vite.web.config.mts",
    "web:build": "vite build --config vite.web.config.mts",
    "web:preview": "vite preview --config vite.web.config.mts",
    "test:web": "npm run web:build && playwright test -c playwright.web.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "compromise": "^14.20.0",
    "pdfjs-dist": "^6.5.438",
    "word-list": "^4.1.0"
  }
}
